<Window x:Class="OpenAADesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenAA Desktop 设置"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="OpenAA Desktop" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Foreground="Gray" Margin="0,2,0,14" />

        <TextBlock Text="字体" FontWeight="SemiBold" />
        <TextBlock x:Name="FontText" Margin="0,4,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="切换字体" Padding="12,4" Margin="0,0,8,0" Click="OnCycleFont" />
            <Button Content="恢复默认字体" Padding="12,4" Click="OnResetFont" />
        </StackPanel>

        <TextBlock Text="壁纸" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
            <Button Content="选择自定义壁纸…" Padding="12,4" Margin="0,0,8,0" Click="OnChooseWallpaper" />
            <Button Content="重新加载默认壁纸" Padding="12,4" Click="OnReloadWallpaper" />
        </StackPanel>

        <CheckBox x:Name="AutoStartCheck" Content="开机启动（登录 Windows 后自动运行）" Margin="0,0,0,16"
                  Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />

        <StackPanel Orientation="Horizontal">
            <Button Content="打开设置文件夹" Padding="12,4" Margin="0,0,8,0" Click="OnOpenFolder" />
            <Button Content="退出程序" Padding="12,4" Margin="0,0,8,0" Click="OnExit" />
            <Button Content="关闭" Padding="12,4" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
